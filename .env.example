# ByteBreach Frontend Environment Variables Template
# Copy this file to .env.local and fill in your values.

# Admin & Credentials (Demo / Setup)
NEXT_PUBLIC_LOCAL_ADMIN_EMAIL=admin@bytebreach.io
NEXT_PUBLIC_LOCAL_ADMIN_PASSWORD=your_secure_password
NEXT_PUBLIC_PRIMARY_ADMIN_EMAIL=admin@bytebreach.io
NEXT_PUBLIC_PRIMARY_ADMIN_PASSWORD=your_secure_password

# Google AdSense & AdMob
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_TOP_SLOT_ID=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT_ID=
NEXT_PUBLIC_ADMOB_PUBLISHER_ID=
NEXT_PUBLIC_ADMOB_MODULE_COMPLETION_AD_UNIT_ID=

# Firebase Client Configuration (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Telegram Daily Challenge Notifications (Server route /api/telegram/notify)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Firebase Admin Service Account (JSON string or file path)
# FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=path/to/service-account.json
